class ImageView(QLabel):
    clicked = Signal(int, int)
    def __init__(self, title=""):
        super().__init__(title); self.setAlignment(Qt.AlignCenter); self.setMinimumSize(160, 120)
        self.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Ignored)
        self.setStyleSheet("background:#000;color:#667;"); self._shape = None
    def set_image(self, bgr):
        h, w = bgr.shape[:2]; self._shape = (h, w)
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        q = QImage(rgb.data, w, h, 3 * w, QImage.Format_RGB888).copy()
        self.setPixmap(QPixmap.fromImage(q).scaled(self.size(), Qt.KeepAspectRatio, Qt.FastTransformation))
    def mousePressEvent(self, e):
        pm = self.pixmap()
        if pm is None or self._shape is None or pm.width() == 0: return
        ox = (self.width() - pm.width()) / 2; oy = (self.height() - pm.height()) / 2
        x = (e.position().x() - ox) * self._shape[1] / pm.width(); y = (e.position().y() - oy) * self._shape[0] / pm.height()
        if 0 <= x < self._shape[1] and 0 <= y < self._shape[0]: self.clicked.emit(int(x), int(y))


def dspin(lo, hi, val, step, dec=2, suffix=""):
    w = QDoubleSpinBox(); w.setRange(lo, hi); w.setDecimals(dec); w.setSingleStep(step); w.setValue(val); w.setSuffix(suffix); return w


