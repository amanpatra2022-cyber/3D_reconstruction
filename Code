# Reconstruction worker
# =====================================================================================
class Cancelled(Exception): pass


class ReconWorker(QThread):
    progress = Signal(str, float)
    finished_ok = Signal(object)
    failed = Signal(str)
    cancelled = Signal()

    def __init__(self, kfs, intr, units, settings: Settings):
        super().__init__(); self.kfs = kfs; self.intr = intr; self.units = units
        self.s = dataclasses.replace(settings); self._cancel = False

    def cancel(self): self._cancel = True
    def _chk(self):
        if self._cancel: raise Cancelled()

    def run(self):
        try: self.finished_ok.emit(self._run())
        except Cancelled: self.cancelled.emit()
        except Exception: self.failed.emit(traceback.format_exc())

    def _p(self, stage, base, weight, i, n):      # fixed stage allocation x real completed fraction
        self.progress.emit(stage, base + weight * (i / max(1, n)))

    def _run(self) -> ReconResult:
        s, kfs, intr, units = self.s, self.kfs, self.intr, self.units
        reg = o3d.pipelines.registration; n = len(kfs); K = o3d_intr(intr)
        voxel = s.recon_voxel_mm / 1000.0; stats = {}
        # 1. per-keyframe clouds
        clouds = []
        for i, k in enumerate(kfs):
            self._chk(); self._p("Building per-view point clouds", 0.0, 0.15, i, n)
            p, c = backproject(k.depth_obj, intr, units, k.depth_obj > 0, k.color_rgb)
            clouds.append(prep_cloud(p, c, 0.003))
        # 2. pose graph with loop closures
        poses = [k.pose.copy() for k in kfs]
        pg = reg.PoseGraph()
        for P in poses: pg.nodes.append(reg.PoseGraphNode(P))
        for i in range(n - 1):
            T = np.linalg.inv(poses[i + 1]) @ poses[i]
            pg.edges.append(reg.PoseGraphEdge(i, i + 1, T, reg.get_information_matrix_from_point_clouds(
                clouds[i], clouds[i + 1], 0.01, T), uncertain=False))
        cand = []
        for i in range(n):
            for j in range(i + 6, n):
                d = np.linalg.norm(poses[i][:3, 3] - poses[j][:3, 3]); cosv = poses[i][:3, 2] @ poses[j][:3, 2]
                if d < 0.15 and cosv > math.cos(math.radians(50)): cand.append((d, i, j))
        cand.sort(); cand = cand[:80]; loops = 0
        for q, (_, i, j) in enumerate(cand):
            self._chk(); self._p("Searching loop closures", 0.15, 0.15, q, len(cand))
            T0 = np.linalg.inv(poses[j]) @ poses[i]
            r = reg.registration_icp(clouds[i], clouds[j], 0.01, T0, reg.TransformationEstimationPointToPlane(),
                                     reg.ICPConvergenceCriteria(max_iteration=50))
            dA, dT = rel_motion(np.linalg.inv(T0) @ r.transformation)
            if r.fitness > 0.45 and r.inlier_rmse < 0.003 and dA < 10 and dT < 0.03:
                pg.edges.append(reg.PoseGraphEdge(i, j, r.transformation, reg.get_information_matrix_from_point_clouds(
                    clouds[i], clouds[j], 0.01, r.transformation), uncertain=True)); loops += 1
        stats["loop_closures"] = loops
        if loops:
            self.progress.emit("Optimising pose graph", 0.30, 0.0); self._chk()
            reg.global_optimization(pg, reg.GlobalOptimizationLevenbergMarquardt(),
                                    reg.GlobalOptimizationConvergenceCriteria(),
                                    reg.GlobalOptimizationOption(max_correspondence_distance=0.01, edge_prune_threshold=0.25,
                                                                 preference_loop_closure=2.0, reference_node=0))
            opt = [np.array(nd.pose) for nd in pg.nodes]
            stats["max_pose_correction_mm"] = round(max(np.linalg.norm(a[:3, 3] - b[:3, 3]) for a, b in zip(poses, opt)) * 1000, 2)
            poses = opt
        # 3. TSDF integration
        vol = o3d.pipelines.integration.ScalableTSDFVolume(
            voxel_length=voxel, sdf_trunc=max(4 * voxel, 0.004),
            color_type=o3d.pipelines.integration.TSDFVolumeColorType.RGB8)
        for i, k in enumerate(kfs):
            self._chk(); self._p("Integrating TSDF volume", 0.30, 0.40, i, n)
            rgbd = o3d.geometry.RGBDImage.create_from_color_and_depth(
                o3d.geometry.Image(np.ascontiguousarray(k.color_rgb)), o3d.geometry.Image(np.ascontiguousarray(k.depth_obj)),
                depth_scale=1.0 / units, depth_trunc=s.depth_max_m, convert_rgb_to_intensity=False)
            vol.integrate(rgbd, K, np.linalg.inv(poses[i]))
        # 4. mesh
        self.progress.emit("Extracting mesh", 0.70, 0.0); self._chk()
        mesh = vol.extract_triangle_mesh()
        if len(mesh.triangles) == 0: raise RuntimeError("No surface could be extracted from the observations.")
        mesh.remove_degenerate_triangles(); mesh.remove_duplicated_triangles(); mesh.remove_duplicated_vertices()
        tc, nt, _ = mesh.cluster_connected_triangles(); tc = np.asarray(tc); nt = np.asarray(nt)
        keep = nt >= 0.05 * nt.max()
        mesh.remove_triangles_by_mask(~keep[tc]); mesh.remove_unreferenced_vertices(); mesh.compute_vertex_normals()
        if len(mesh.triangles) == 0: raise RuntimeError("Mesh empty after cleanup.")
        # 5. fused point cloud from the actual observations
        self._chk(); acc = o3d.geometry.PointCloud()
        for i, k in enumerate(kfs):
            self._chk(); self._p("Fusing point cloud", 0.75, 0.2, i, n)
            p, c = backproject(k.depth_obj, intr, units, k.depth_obj > 0, k.color_rgb)
            pc = make_cloud(p, c).voxel_down_sample(voxel); pc.transform(poses[i]); acc += pc
        acc = acc.voxel_down_sample(voxel)
        acc, _ = acc.remove_statistical_outlier(20, 2.0)
        # 6. model frame
        mesh.transform(FLIP); acc.transform(FLIP)
        c = mesh.get_axis_aligned_bounding_box().get_center(); Tc = np.eye(4); Tc[:3, 3] = -c
        mesh.transform(Tc); acc.transform(Tc); mesh.compute_vertex_normals()
        ext = mesh.get_axis_aligned_bounding_box().get_extent()
        stats.update(keyframes=n, vertices=len(mesh.vertices), triangles=len(mesh.triangles), points=len(acc.points),
                     bbox_mm=[round(float(x) * 1000, 1) for x in ext], voxel_mm=s.recon_voxel_mm,
                     watertight=bool(mesh.is_watertight()), mean_fitness=round(float(np.mean([k.fitness for k in kfs[1:]])), 2))
        self.progress.emit("Done", 1.0, 0.0)
        return ReconResult(mesh, acc, stats, Tc @ FLIP)


