        self.v_rgb.set_image(draw_overlay(f.color, self.last_res, self.session.state))
        self.v_depth.set_image(colorize_depth(f.depth, f.units, self.settings.depth_min_m, self.settings.depth_max_m))

    def refresh_ui(self):
