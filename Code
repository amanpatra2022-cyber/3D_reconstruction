# 3D viewport (QOpenGLWidget, fixed-function OpenGL) with shared-capable orbit camera
# =====================================================================================
class OrbitCamera(QObject):
    changed = Signal(); user_changed = Signal()
    def __init__(self):
        super().__init__(); self.az = math.radians(40); self.el = math.radians(25); self.dist = 0.8
        self.target = np.zeros(3); self.fov = 45.0; self.radius = 0.2
    def state(self): return (self.az, self.el, self.dist, self.target.copy(), self.fov, self.radius)
    def set_state(self, st):
        self.az, self.el, self.dist, t, self.fov, self.radius = st; self.target = np.array(t, float); self.changed.emit()
    def eye(self):
        return self.target + self.dist * np.array([math.cos(self.el) * math.cos(self.az), math.sin(self.el),
                                                   math.cos(self.el) * math.sin(self.az)])
    def basis(self):
        f = self.target - self.eye(); f /= np.linalg.norm(f)
        r = np.cross(f, [0, 1, 0]); r /= np.linalg.norm(r) + 1e-12
        return r, np.cross(r, f)
    def _u(self): self.changed.emit(); self.user_changed.emit()
    def orbit(self, dx, dy):
        self.az -= dx * 0.01; self.el = float(np.clip(self.el + dy * 0.01, -1.5533, 1.5533)); self._u()
    def zoom(self, steps):
        self.dist = float(np.clip(self.dist * 0.88 ** steps, self.radius * 0.2, self.radius * 40)); self._u()
    def pan(self, dx, dy, h):
        r, u = self.basis(); k = 2 * self.dist * math.tan(math.radians(self.fov / 2)) / max(1, h)
        self.target = self.target + (-r * dx + u * dy) * k; self._u()
    def fit(self, center, radius):
        self.target = np.array(center, float); self.radius = max(radius, 1e-3)
        self.dist = self.radius / math.sin(math.radians(self.fov / 2)) * 1.1; self.changed.emit()
    def view(self, name, center, radius):
        self.fit(center, radius)
        self.az, self.el = {"front": (math.pi / 2, 0.0), "side": (0.0, 0.0), "top": (math.pi / 2, 1.5533),
                            "iso": (math.radians(45), math.radians(35))}[name]
        self.changed.emit()


class GLViewport(QOpenGLWidget):
    activated = Signal()
    def __init__(self, parent=None):
        super().__init__(parent)
        self.cam = OrbitCamera(); self.cam.changed.connect(self.update)
        self.P = None; self.Crgb = None; self.Cdepth = None; self.V = None; self.F = None; self.N = None; self.Cm = None
        self.nlines = None; self.bmin = -np.ones(3) * 0.1; self.bmax = np.ones(3) * 0.1
        self.point_size = 3.0; self.show_points = True; self.show_mesh = False; self.mesh_mode = "solid"
        self.show_normals = False; self.show_axes = True; self.show_bbox = False; self.mesh_colored = False
        self.depth_mode = False; self.user_touched = False; self._last = None
        self.label = QLabel(self); self.label.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.label.setStyleSheet("background:rgba(0,0,0,150);color:#d8e6f0;padding:4px;font:11px Consolas;")
        self.label.move(8, 8); self.label.hide()

    def set_info(self, text):
        self.label.setText(text); self.label.setVisible(bool(text)); self.label.adjustSize()

    def _bounds(self):
        lo, hi = [], []
        for A in (self.P, self.V):
            if A is not None and len(A): lo.append(A.min(0)); hi.append(A.max(0))
        if lo: self.bmin, self.bmax = np.min(lo, 0), np.max(hi, 0)
    def center_radius(self):
        return (self.bmin + self.bmax) / 2, max(1e-3, float(np.linalg.norm(self.bmax - self.bmin)) / 2)

    def set_points(self, P, C):
        self.P = np.ascontiguousarray(P, np.float32); self.Crgb = np.ascontiguousarray(C, np.float32)
        if len(P) > 1:
            z = P[:, 2]; lo, hi = np.percentile(z, [2, 98])
            t = np.clip((z - lo) / (hi - lo + 1e-9), 0, 1)
            col = cv2.applyColorMap((t * 255).astype(np.uint8).reshape(-1, 1), cv2.COLORMAP_TURBO)[:, 0, ::-1] / 255.0
            self.Cdepth = np.ascontiguousarray(col, np.float32)
        else: self.Cdepth = self.Crgb
        self._bounds(); self.update()
    def set_mesh(self, V, F, N, C):
        self.V = np.ascontiguousarray(V, np.float32); self.F = np.ascontiguousarray(F, np.uint32)
        self.N = np.ascontiguousarray(N, np.float32); self.Cm = np.ascontiguousarray(C, np.float32) if C is not None and len(C) == len(V) else None
        step = max(1, len(V) // 3000); L = 0.03 * float(np.linalg.norm(V.max(0) - V.min(0)))
        a = self.V[::step]; b = a + self.N[::step] * L
        self.nlines = np.ascontiguousarray(np.stack([a, b], 1).reshape(-1, 3), np.float32)
        self._bounds(); self.update()
    def clear(self):
        self.P = self.V = self.F = None; self.update()
    def fit_view(self):
        c, r = self.center_radius(); self.cam.fit(c, r)

    # ---- GL ---------------------------------------------------------------------------
    def initializeGL(self):
        gl.glEnable(gl.GL_DEPTH_TEST); gl.glEnable(gl.GL_NORMALIZE); gl.glEnable(gl.GL_POINT_SMOOTH)
        gl.glLightModeli(gl.GL_LIGHT_MODEL_TWO_SIDE, 1)
    def paintGL(self):
        gl.glClearColor(0.07, 0.08, 0.10, 1); gl.glClear(gl.GL_COLOR_BUFFER_BIT | gl.GL_DEPTH_BUFFER_BIT)
        c = self.cam; w, h = max(1, self.width()), max(1, self.height())
        gl.glMatrixMode(gl.GL_PROJECTION); gl.glLoadIdentity()
        glu.gluPerspective(c.fov, w / h, max(1e-4, c.dist * 0.01), c.dist * 30 + c.radius * 10)
        gl.glMatrixMode(gl.GL_MODELVIEW); gl.glLoadIdentity()
        gl.glEnable(gl.GL_LIGHT0); gl.glLightfv(gl.GL_LIGHT0, gl.GL_POSITION, (0.3, 0.6, 1.0, 0.0))
        gl.glLightfv(gl.GL_LIGHT0, gl.GL_DIFFUSE, (0.9, 0.9, 0.9, 1)); gl.glLightfv(gl.GL_LIGHT0, gl.GL_AMBIENT, (0.25, 0.25, 0.28, 1))
        e = c.eye(); t = c.target; glu.gluLookAt(e[0], e[1], e[2], t[0], t[1], t[2], 0, 1, 0)
        if self.show_axes: self._axes()
        if self.show_mesh and self.V is not None and self.F is not None: self._mesh()
        if self.show_points and self.P is not None and len(self.P): self._points()
        if self.show_bbox: self._bbox()
    def _points(self):
        gl.glDisable(gl.GL_LIGHTING); gl.glPointSize(self.point_size)
        gl.glEnableClientState(gl.GL_VERTEX_ARRAY); gl.glEnableClientState(gl.GL_COLOR_ARRAY)
        gl.glVertexPointer(3, gl.GL_FLOAT, 0, self.P)
        gl.glColorPointer(3, gl.GL_FLOAT, 0, self.Cdepth if self.depth_mode else self.Crgb)
        gl.glDrawArrays(gl.GL_POINTS, 0, len(self.P))
        gl.glDisableClientState(gl.GL_COLOR_ARRAY); gl.glDisableClientState(gl.GL_VERTEX_ARRAY)
    def _mesh(self):
        gl.glEnableClientState(gl.GL_VERTEX_ARRAY); gl.glVertexPointer(3, gl.GL_FLOAT, 0, self.V)
        if self.mesh_mode in ("solid", "both"):
            gl.glEnable(gl.GL_LIGHTING); gl.glEnableClientState(gl.GL_NORMAL_ARRAY); gl.glNormalPointer(gl.GL_FLOAT, 0, self.N)
            gl.glEnable(gl.GL_COLOR_MATERIAL); gl.glColorMaterial(gl.GL_FRONT_AND_BACK, gl.GL_AMBIENT_AND_DIFFUSE)
            if self.mesh_colored and self.Cm is not None:
                gl.glEnableClientState(gl.GL_COLOR_ARRAY); gl.glColorPointer(3, gl.GL_FLOAT, 0, self.Cm)
            else: gl.glColor3f(0.70, 0.74, 0.80)
            if self.mesh_mode == "both": gl.glEnable(gl.GL_POLYGON_OFFSET_FILL); gl.glPolygonOffset(1.0, 1.0)
            gl.glDrawElements(gl.GL_TRIANGLES, self.F.size, gl.GL_UNSIGNED_INT, self.F)
            gl.glDisable(gl.GL_POLYGON_OFFSET_FILL); gl.glDisableClientState(gl.GL_COLOR_ARRAY)
            gl.glDisableClientState(gl.GL_NORMAL_ARRAY); gl.glDisable(gl.GL_COLOR_MATERIAL)
        if self.mesh_mode in ("wire", "both"):
            gl.glDisable(gl.GL_LIGHTING); gl.glColor3f(0.2, 0.85, 1.0); gl.glLineWidth(1.0)
            gl.glPolygonMode(gl.GL_FRONT_AND_BACK, gl.GL_LINE)
            gl.glDrawElements(gl.GL_TRIANGLES, self.F.size, gl.GL_UNSIGNED_INT, self.F)
            gl.glPolygonMode(gl.GL_FRONT_AND_BACK, gl.GL_FILL)
        if self.show_normals and self.nlines is not None:
            gl.glDisable(gl.GL_LIGHTING); gl.glColor3f(1.0, 0.8, 0.2)
            gl.glVertexPointer(3, gl.GL_FLOAT, 0, self.nlines); gl.glDrawArrays(gl.GL_LINES, 0, len(self.nlines))
        gl.glDisableClientState(gl.GL_VERTEX_ARRAY); gl.glDisable(gl.GL_LIGHTING)
    def _axes(self):
        gl.glDisable(gl.GL_LIGHTING); L = 0.6 * self.center_radius()[1]; gl.glLineWidth(2.5); gl.glBegin(gl.GL_LINES)
        for col, d in (((1, .2, .2), (L, 0, 0)), ((.2, 1, .2), (0, L, 0)), ((.3, .5, 1), (0, 0, L))):
            gl.glColor3f(*col); gl.glVertex3f(0, 0, 0); gl.glVertex3f(*d)
        gl.glEnd(); gl.glLineWidth(1.0)
    def _bbox(self):
        gl.glDisable(gl.GL_LIGHTING); a, b = self.bmin, self.bmax; gl.glColor3f(1, 0.9, 0.2); gl.glBegin(gl.GL_LINES)
        cs = [(x, y, z) for x in (a[0], b[0]) for y in (a[1], b[1]) for z in (a[2], b[2])]
        for i in range(8):
            for j in range(i + 1, 8):
                if sum(cs[i][k] != cs[j][k] for k in range(3)) == 1: gl.glVertex3f(*cs[i]); gl.glVertex3f(*cs[j])
        gl.glEnd()

    # ---- mouse ------------------------------------------------------------------------
    def mousePressEvent(self, e): self._last = e.position(); self.activated.emit()
    def mouseMoveEvent(self, e):
        if self._last is None: return
        p = e.position(); dx, dy = p.x() - self._last.x(), p.y() - self._last.y(); self._last = p
        self.user_touched = True
        b = e.buttons()
        if (b & Qt.LeftButton) and not (e.modifiers() & Qt.ShiftModifier): self.cam.orbit(dx, dy)
        elif b & (Qt.RightButton | Qt.MiddleButton | Qt.LeftButton): self.cam.pan(dx, dy, self.height())
    def wheelEvent(self, e):
        self.user_touched = True; self.activated.emit(); self.cam.zoom(e.angleDelta().y() / 120.0)
    def mouseDoubleClickEvent(self, e): self.fit_view(); self.cam.user_changed.emit()


