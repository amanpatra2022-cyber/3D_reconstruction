        self.sync.toggled.connect(lambda on: on and self.right.cam.set_state(self.left.cam.state()))
        self._opts()

    def _sync(self, src, dst):
        if self.sync.isChecked(): dst.cam.set_state(src.cam.state())
    def _apply(self, fn):
        fn(self.active.cam); self.active.cam.changed.emit(); self.active.cam.user_changed.emit()
    def _view(self, name):
        c, r = self.left.center_radius(); self._apply(lambda cam: cam.view(name, c, r))
    def _opts(self):
        l, r = self.left, self.right
        l.mesh_mode = ["solid", "wire", "both"][self.mode.currentIndex()]; l.show_normals = self.c_norm.isChecked()
        l.show_axes = r.show_axes = self.c_axes.isChecked(); l.show_bbox = r.show_bbox = self.c_bbox.isChecked()
        r.depth_mode = self.cmode.currentIndex() == 1; r.show_mesh = self.c_surf.isChecked()
        r.mesh_mode = "solid"; r.mesh_colored = True; r.point_size = float(self.psize.value())
        l.update(); r.update()

    def set_result(self, res: ReconResult):
        self.result = res; m = res.mesh
        V = np.asarray(m.vertices); F = np.asarray(m.triangles); N = np.asarray(m.vertex_normals)
        C = np.asarray(m.vertex_colors) if m.has_vertex_colors() else None
        P = np.asarray(res.cloud.points); Cc = np.asarray(res.cloud.colors)
        for v in (self.left, self.right): v.set_mesh(V, F, N, C)
        self.left.set_points(P, Cc); self.right.set_points(P, Cc)
        self.left.bmin = self.right.bmin = V.min(0); self.left.bmax = self.right.bmax = V.max(0)
        self.left.show_points = False
        e = (V.max(0) - V.min(0)) * 1000; st = res.stats
        self.left.set_info(f"Vertices {st['vertices']:,}   Triangles {st['triangles']:,}\n"
                           f"BBox (axis-aligned) X {e[0]:.1f} x Y {e[1]:.1f} x Z {e[2]:.1f} mm\nAxes: X red, Y green, Z blue")
        self.right.set_info(f"Points {st['points']:,}   Keyframes {st['keyframes']}   Loop closures {st.get('loop_closures', 0)}\n"
                            f"Voxel {st['voxel_mm']} mm   Mean reg. fitness {st['mean_fitness']}\n"
                            f"Mesh watertight: {'yes' if st['watertight'] else 'NO - unobserved surfaces remain open'}")
        self._view("iso")


