# =====================================================================================
# Settings, data containers
# =====================================================================================
@dataclass
class Settings:
    yolo_weights: str = "yolov8n-seg.pt"
    yolo_conf: float = 0.35
    infer_interval_ms: int = 100          # idle detection period (scanning runs as fast as possible)
    depth_min_m: float = 0.07             # D405 minimum sensible range
    depth_max_m: float = 0.50
    live_voxel_mm: float = 2.0
    recon_voxel_mm: float = 1.0
    kf_angle_deg: float = 8.0
    kf_trans_cm: float = 2.0
    max_keyframes: int = 150
    min_object_px: int = 2000
    min_fitness: float = 0.30
    export_units: str = "m"


@dataclass
class Frame:
    seq: int
    ts: float
    color: np.ndarray        # BGR uint8
    depth: np.ndarray        # uint16 raw z16 aligned to colour
    intr: dict
    units: float             # meters per depth unit


class FrameHub:
    def __init__(self):
        self.lock = threading.Lock(); self.latest: Optional[Frame] = None
    def put(self, f: Frame):
        with self.lock: self.latest = f
    def get_after(self, seq: int) -> Optional[Frame]:
        with self.lock:
            f = self.latest
        return f if (f is not None and f.seq > seq) else None
    def peek(self) -> Optional[Frame]:
        with self.lock: return self.latest


@dataclass
class Detection:
    box: Tuple[float, float, float, float]
    conf: float
    poly: np.ndarray
    centroid: Tuple[float, float]


@dataclass
class DetectionResult:
    seq: int
    dets: List[Detection]
    target: Optional[int]
    distance_m: Optional[float]
    valid_px: int
    message: str


@dataclass
class Keyframe:
    color_rgb: np.ndarray
    depth_obj: np.ndarray    # uint16, zero outside the segmented object
    pose: np.ndarray         # camera->world (4x4)
    fitness: float
    ts: float
    valid_px: int


class ScanState(enum.Enum):
    IDLE = "Idle"; SCANNING = "Scanning"; PAUSED = "Paused"; CAPTURED = "Captured (locked)"
    RECONSTRUCTING = "Reconstructing"; DONE = "Done"


class ScanSession:
    """Shared between GUI and perception thread; all mutation under `lock`."""
    def __init__(self):
        self.lock = threading.RLock(); self.generation = 0; self.intr = None; self.units = 1e-4
        self.reset()
    def reset(self):
        with self.lock:
            self.state = ScanState.IDLE; self.keyframes: List[Keyframe] = []
            self.generation += 1; self.seen = 0; self.rej_track = 0; self.rej_quality = 0
            self.status = "No scan"; self.last_fitness = 0.0


@dataclass
class ReconResult:
    mesh: "o3d.geometry.TriangleMesh"
    cloud: "o3d.geometry.PointCloud"
    stats: dict
    model_transform: np.ndarray


# =====================================================================================
# Geometry helpers
# =====================================================================================
def o3d_intr(i: dict):
    return o3d.camera.PinholeCameraIntrinsic(int(i["w"]), int(i["h"]), i["fx"], i["fy"], i["cx"], i["cy"])


def backproject(depth, intr, units, valid, color_rgb=None):
    ys, xs = np.nonzero(valid)
    z = depth[ys, xs].astype(np.float64) * units
    x = (xs - intr["cx"]) / intr["fx"] * z
    y = (ys - intr["cy"]) / intr["fy"] * z
    pts = np.stack([x, y, z], 1)
    cols = color_rgb[ys, xs].astype(np.float64) / 255.0 if color_rgb is not None else None
    return pts, cols


def make_cloud(pts, cols=None):
    pc = o3d.geometry.PointCloud()
    pc.points = o3d.utility.Vector3dVector(np.ascontiguousarray(pts, dtype=np.float64))
    if cols is not None:
        pc.colors = o3d.utility.Vector3dVector(np.ascontiguousarray(cols, dtype=np.float64))
    return pc


def clean_depth(depth, units, dmin, dmax):
    """Range-gate and remove flying pixels (depth edges) using a median consistency test."""
    d = depth.copy()
    d[(d < int(dmin / units)) | (d > int(dmax / units))] = 0
    med = cv2.medianBlur(d, 5)
    bad = (d > 0) & (np.abs(d.astype(np.int32) - med.astype(np.int32)) > max(1, int(0.008 / units)))
    d[bad] = 0
    return d


def poly_mask(poly, shape):
    m = np.zeros(shape[:2], np.uint8); cv2.fillPoly(m, [poly], 255); return m


def rel_motion(T):
    ang = math.degrees(math.acos(max(-1.0, min(1.0, (np.trace(T[:3, :3]) - 1) / 2))))
    return ang, float(np.linalg.norm(T[:3, 3]))


def prep_cloud(pts, cols, voxel, normals=True):
    pc = make_cloud(pts, cols)
    if len(pc.points) == 0: return pc
    pc = pc.voxel_down_sample(voxel)
    if len(pc.points) > 30:
        pc, _ = pc.remove_statistical_outlier(16, 2.0)
    if normals and len(pc.points) > 10:
        pc.estimate_normals(o3d.geometry.KDTreeSearchParamHybrid(voxel * 4, 30))
    return pc


def colorize_depth(depth, units, dmin, dmax):
    z = depth.astype(np.float32) * units
    t = np.clip((z - dmin) / max(1e-6, dmax - dmin), 0, 1)
    img = cv2.applyColorMap((t * 255).astype(np.uint8), cv2.COLORMAP_JET)
    img[depth == 0] = 0
    return img


def draw_overlay(color, res: Optional[DetectionResult], state: ScanState):
    img = color.copy()
    if res is not None:
        layer = img.copy()
        for i, d in enumerate(res.dets):
            is_t = (i == res.target)
            col = (0, 220, 120) if is_t else (150, 150, 150)
            if is_t: cv2.fillPoly(layer, [d.poly], col)
            cv2.polylines(img, [d.poly], True, col, 2)
            x1, y1 = int(d.box[0]), int(d.box[1])
            cv2.putText(img, f"bottle {d.conf:.2f}" + (" [target]" if is_t else ""), (x1, max(14, y1 - 6)),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, col, 1, cv2.LINE_AA)
        img = cv2.addWeighted(layer, 0.3, img, 0.7, 0)
        if res.distance_m:
            cv2.putText(img, f"{res.distance_m*100:.1f} cm", (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                        (0, 255, 255), 2, cv2.LINE_AA)
    cv2.putText(img, state.value, (10, img.shape[0] - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                (255, 255, 255), 2, cv2.LINE_AA)
    return img


# =====================================================================================
# Camera thread (the ONLY owner of the RealSense pipeline)
# =====================================================================================
class CameraThread(QThread):
    status = Signal(str, bool)

    def __init__(self, hub: FrameHub):
        super().__init__(); self.hub = hub; self._stop = False; self.seq = 0
        self.intr = None; self.units = 1e-4; self.dropped = 0

    def stop(self): self._stop = True

    def run(self):
        if rs is None:
            self.status.emit("pyrealsense2 not installed", False); return
        while not self._stop:
            pipe = None
            try:
                pipe = self._open()
                self._loop(pipe)
            except Exception as e:
                self.status.emit(f"Camera unavailable: {e}  (retrying)", False)
            finally:
                try:
                    if pipe is not None: pipe.stop()
                except Exception: pass
            for _ in range(20):
                if self._stop: break
                self.msleep(100)

    def _open(self):
        ctx = rs.context(); devs = ctx.query_devices()
        if len(devs) == 0: raise RuntimeError("no RealSense device found")
        dev = devs[0]; name = dev.get_info(rs.camera_info.name); sn = dev.get_info(rs.camera_info.serial_number)
        last = None; prof = None; pipe = None
        for (w, h) in [(848, 480), (640, 480), (1280, 720)]:
            pipe = rs.pipeline(ctx); cfg = rs.config(); cfg.enable_device(sn)
            cfg.enable_stream(rs.stream.depth, w, h, rs.format.z16, 30)
            cfg.enable_stream(rs.stream.color, w, h, rs.format.bgr8, 30)
            try:
                prof = pipe.start(cfg); break
            except RuntimeError as e:
                last = e; prof = None
        if prof is None: raise RuntimeError(f"cannot start streams: {last}")
        self.units = prof.get_device().first_depth_sensor().get_depth_scale()
        i = prof.get_stream(rs.stream.color).as_video_stream_profile().get_intrinsics()
        self.intr = dict(w=i.width, h=i.height, fx=i.fx, fy=i.fy, cx=i.ppx, cy=i.ppy)
        self.align = rs.align(rs.stream.color)
        warn = "" if "405" in name else "  (WARNING: not a D405)"
        self.status.emit(f"Connected: {name} S/N {sn}  {i.width}x{i.height}@30  depth unit {self.units*1e6:.0f} um{warn}", True)
        return pipe

    def _loop(self, pipe):
        while not self._stop:
            frames = pipe.wait_for_frames(5000)       # raises RuntimeError on disconnect
            frames = self.align.process(frames)
            d = frames.get_depth_frame(); c = frames.get_color_frame()
            if not d or not c:
                self.dropped += 1; continue
            self.seq += 1
            self.hub.put(Frame(self.seq, time.time(), np.asanyarray(c.get_data()).copy(),
                               np.asanyarray(d.get_data()).copy(), self.intr, self.units))


# =====================================================================================
# Perception thread: YOLO detection/segmentation + live cloud + scan tracking
# =====================================================================================
class PerceptionWorker(QThread):
    detections = Signal(object)
    live_cloud = Signal(object, object)
    scan_update = Signal(dict)
    status = Signal(str)
    error = Signal(str)

    def __init__(self, hub: FrameHub, session: ScanSession, settings: Settings):
        super().__init__()
        self.hub, self.session, self.s = hub, session, settings
        self._stop = False; self.reload = True; self.model = None; self.cls_ids = [39]
        self.device = "cpu"; self.select_point = None; self.prev_centroid = None
        self.gen = -1; self._reset_ref()

    def stop(self): self._stop = True
    def _reset_ref(self): self.ref_rgbd = None; self.ref_cloud = None; self.ref_pose = None

    # ---- model -----------------------------------------------------------------------
    def _load_model(self):
        if YOLO is None: raise RuntimeError(f"ultralytics unavailable: {_YOLO_ERR}")
        self.status.emit(f"Loading YOLO model {self.s.yolo_weights} (first run may download it)...")
        try:
            import torch
            self.device = 0 if torch.cuda.is_available() else "cpu"
        except Exception: self.device = "cpu"
        self.model = YOLO(self.s.yolo_weights)
        names = self.model.names
        ids = [k for k, v in names.items() if v == "bottle"]
        self.cls_ids = ids or [39]
        self.status.emit(f"YOLO ready on {'GPU' if self.device == 0 else 'CPU'}")

    def _detect(self, color) -> List[Detection]:
        if self.model is None: return []
        r = self.model.predict(color, conf=self.s.yolo_conf, classes=self.cls_ids, imgsz=640,
                               device=self.device, verbose=False)[0]
        out = []
        if r.boxes is None or len(r.boxes) == 0 or r.masks is None: return out
        for i, b in enumerate(r.boxes):
            poly = r.masks.xy[i]
            if poly is None or len(poly) < 3: continue
            poly = np.round(poly).astype(np.int32)
            cx, cy = poly.mean(0)
            out.append(Detection(tuple(b.xyxy[0].tolist()), float(b.conf[0]), poly, (float(cx), float(cy))))
        return out

    def _pick(self, dets, scanning) -> Optional[int]:
        if not dets: return None
        sp = self.select_point
        if sp is not None:
            self.select_point = None
            best = None
            for i, d in enumerate(dets):
                if cv2.pointPolygonTest(d.poly.astype(np.float32), (float(sp[0]), float(sp[1])), False) >= 0: best = i
            if best is None:
                best = int(np.argmin([math.hypot(d.centroid[0] - sp[0], d.centroid[1] - sp[1]) for d in dets]))
            self.prev_centroid = dets[best].centroid; return best
        if self.prev_centroid is not None:
            dist = [math.hypot(d.centroid[0] - self.prev_centroid[0], d.centroid[1] - self.prev_centroid[1]) for d in dets]
            j = int(np.argmin(dist))
            if dist[j] < 160: self.prev_centroid = dets[j].centroid; return j
            if scanning: return None
        j = int(np.argmax([d.conf for d in dets])); self.prev_centroid = dets[j].centroid; return j

    # ---- main loop -------------------------------------------------------------------
    def run(self):
        last_seq = 0; last_infer = 0.0; self._last_cloud = 0.0; last_err = 0.0
        while not self._stop:
            if self.reload:
                self.reload = False
                try: self._load_model()
                except Exception as e: self.model = None; self.error.emit(f"Detection disabled: {e}")
            st = self.session.state
            if st == ScanState.RECONSTRUCTING: self.msleep(100); continue
            f = self.hub.get_after(last_seq)
            if f is None: self.msleep(4); continue
            scanning = st == ScanState.SCANNING
            now = time.time()
            if not scanning and (now - last_infer) * 1000 < self.s.infer_interval_ms: self.msleep(4); continue
            last_seq = f.seq; last_infer = now
            try: self._process(f, scanning)
            except Exception:
                if time.time() - last_err > 3:
                    last_err = time.time(); self.error.emit("Processing error:\n" + traceback.format_exc())

    def _process(self, f: Frame, scanning: bool):
        s = self.s
        dets = self._detect(f.color)
        t = self._pick(dets, scanning)
        res = DetectionResult(f.seq, dets, t, None, 0, "")
        if self.model is None: res.message = "Detection unavailable (see log)"
        elif not dets: res.message = "No bottle detected"
        elif t is None: res.message = "Target bottle lost"
        if t is not None:
            clean = clean_depth(f.depth, f.units, s.depth_min_m, s.depth_max_m)
            mask = cv2.erode(poly_mask(dets[t].poly, f.color.shape), np.ones((5, 5), np.uint8))
            valid = (mask > 0) & (clean > 0)
            res.valid_px = int(valid.sum())
            if res.valid_px > 50:
                res.distance_m = float(np.median(clean[valid]) * f.units)
            else: res.message = "No valid depth on target"
            rgb = cv2.cvtColor(f.color, cv2.COLOR_BGR2RGB)
            if time.time() - self._last_cloud > 0.5 and res.valid_px > 50:
                self._last_cloud = time.time()
                p, c = backproject(clean, f.intr, f.units, valid, rgb)
                pc = prep_cloud(p, c, s.live_voxel_mm / 1000.0, normals=False)
                self.live_cloud.emit(np.asarray(pc.points, np.float32), np.asarray(pc.colors, np.float32))
            if scanning: self._track(f, clean, valid, rgb, res)
        elif scanning:
            self._note("Target lost - point the camera at the bottle", reject="track")
        self.detections.emit(res)

    # ---- tracking --------------------------------------------------------------------
    def _note(self, msg, reject=None):
        with self.session.lock:
            self.session.status = msg
            if reject == "track": self.session.rej_track += 1
            if reject == "quality": self.session.rej_quality += 1
        self._emit_scan()

    def _emit_scan(self):
        se = self.session
        self.scan_update.emit(dict(seen=se.seen, accepted=len(se.keyframes), rej_track=se.rej_track,
                                   rej_quality=se.rej_quality, status=se.status, fitness=se.last_fitness))

    def _track(self, f, clean, valid, rgb, res):
        se, s = self.session, self.s
        if se.generation != self.gen: self._reset_ref(); self.gen = se.generation
        with se.lock: se.seen += 1; se.intr = f.intr; se.units = f.units
        if res.valid_px < s.min_object_px:
            self._note(f"Too few valid object depth pixels ({res.valid_px} < {s.min_object_px})", "quality"); return
        K = o3d_intr(f.intr)
        depth_obj = np.where(valid, clean, 0).astype(np.uint16)
        p, c = backproject(depth_obj, f.intr, f.units, depth_obj > 0, rgb)
        cloud = prep_cloud(p, c, 0.003)
        if len(cloud.points) < 200: self._note("Object cloud too sparse", "quality"); return
        rgbd = o3d.geometry.RGBDImage.create_from_color_and_depth(
            o3d.geometry.Image(np.ascontiguousarray(rgb)), o3d.geometry.Image(np.ascontiguousarray(clean)),
            depth_scale=1.0 / f.units, depth_trunc=s.depth_max_m, convert_rgb_to_intensity=True)
        if self.ref_rgbd is None:
            self._accept(rgb, depth_obj, np.eye(4), 1.0, res.valid_px, rgbd, cloud, "First keyframe stored"); return
        # 1) RGB-D hybrid odometry current -> reference keyframe (whole scene gives constraints
        #    that a symmetric bottle alone cannot, e.g. rotation about its axis)
        T = None; mode = ""
        try:
            opt = o3d.pipelines.odometry.OdometryOption()
            opt.depth_min = s.depth_min_m; opt.depth_max = s.depth_max_m; opt.depth_diff_max = 0.02
            ok, Tod, _ = o3d.pipelines.odometry.compute_rgbd_odometry(
                rgbd, self.ref_rgbd, K, np.eye(4),
                o3d.pipelines.odometry.RGBDOdometryJacobianFromHybridTerm(), opt)
            if ok: T = Tod; mode = "RGB-D odometry"
        except Exception: ok = False
        if T is None: T = np.eye(4); mode = "ICP only"
        ang, tr = rel_motion(T)
        if ang > 45 or tr > 0.20:
            self._note(f"Tracking jump rejected ({ang:.0f} deg, {tr*100:.0f} cm) - move slower / return to last view", "track"); return
        # 2) ICP refinement on the object, guarded so it can't slide along the bottle axis
        reg = o3d.pipelines.registration
        try:
            r = reg.registration_icp(cloud, self.ref_cloud, 0.008, T, reg.TransformationEstimationPointToPlane(),
                                     reg.ICPConvergenceCriteria(max_iteration=30))
            dA, dT = rel_motion(np.linalg.inv(T) @ r.transformation)
            if dA < 6 and dT < 0.02 and r.fitness > 0.1:
                T = r.transformation; mode += " + ICP"
        except Exception: pass
        ev = reg.evaluate_registration(cloud, self.ref_cloud, 0.01, T)
        if ev.fitness < s.min_fitness or ev.inlier_rmse > 0.006:
            self._note(f"Poor registration (fitness {ev.fitness:.2f}, rmse {ev.inlier_rmse*1000:.1f} mm) - frame rejected", "track"); return
        ang, tr = rel_motion(T)
        if ang < s.kf_angle_deg and tr * 100 < s.kf_trans_cm:
            self._note(f"Tracking OK ({mode}, fitness {ev.fitness:.2f}) - keep moving around the bottle")
            with se.lock: se.last_fitness = ev.fitness
            return
        pose = self.ref_pose @ T
        self._accept(rgb, depth_obj, pose, ev.fitness, res.valid_px, rgbd, cloud, f"Keyframe added ({mode})")

    def _accept(self, rgb, depth_obj, pose, fit, npx, rgbd, cloud, msg):
        se = self.session
        with se.lock:
            if se.state != ScanState.SCANNING or se.generation != self.gen: return
            if len(se.keyframes) >= self.s.max_keyframes:
                se.status = "Maximum keyframes reached"; self._emit_scan(); return
            se.keyframes.append(Keyframe(rgb.copy(), depth_obj, pose.copy(), float(fit), time.time(), int(npx)))
            se.last_fitness = fit; se.status = msg
        self.ref_rgbd, self.ref_cloud, self.ref_pose = rgbd, cloud, pose.copy()
        self._emit_scan()


# =====================================================================================
# Scan review
# =====================================================================================
def review_keyframes(kfs: List[Keyframe], intr, units, s: Settings):
    msgs = []; info = {}
    n = len(kfs); info["keyframes"] = n
    if n < 3:
        msgs.append(("error", f"Only {n} accepted keyframes; at least 3 are required (12+ recommended)."))
        return msgs, info
    if n < 12: msgs.append(("warn", f"Only {n} keyframes - coverage is probably insufficient (12+ recommended)."))
    cents = []
    for k in kfs:
        p, _ = backproject(k.depth_obj[::4, ::4], dict(cx=intr["cx"] / 4, cy=intr["cy"] / 4, fx=intr["fx"] / 4,
                           fy=intr["fy"] / 4), units, k.depth_obj[::4, ::4] > 0)
        if len(p): cents.append((k.pose @ np.append(p.mean(0), 1))[:3])
    obj = np.median(np.array(cents), 0)
    C = np.array([k.pose[:3, 3] for k in kfs]); v = C - obj
    vm = v - v.mean(0); _, sv, vt = np.linalg.svd(vm)
    if sv[1] < 0.1 * max(sv[0], 1e-9):
        msgs.append(("warn", "Camera path is almost a straight line - the bottle was not orbited; coverage estimate unreliable."))
    nrm = vt[2]; e1 = v[0] - nrm * (v[0] @ nrm); e1 /= np.linalg.norm(e1) + 1e-12; e2 = np.cross(nrm, e1)
    ang = np.degrees(np.arctan2(v @ e2, v @ e1)) % 360
    hist = np.histogram(ang, bins=12, range=(0, 360))[0]
    empty = [i for i in range(12) if hist[i] == 0]
    info["azimuth_coverage_pct"] = round(100 * (12 - len(empty)) / 12, 1)
    if empty:
        msgs.append(("warn", "No views in azimuth sectors (deg from start): " + ", ".join(f"{i*30}-{i*30+30}" for i in empty) + "."))
    h = v @ nrm; rad = np.linalg.norm(v - np.outer(h, nrm), axis=1)
    el = np.degrees(np.arctan2(h, rad)); info["elevation_range_deg"] = round(float(el.max() - el.min()), 1)
    if el.max() - el.min() < 20: msgs.append(("warn", "Little elevation variation: top of the bottle / neck may be unobserved."))
    steps = [rel_motion(np.linalg.inv(kfs[i].pose) @ kfs[i + 1].pose)[0] for i in range(n - 1)]
    if max(steps) > 25: msgs.append(("warn", f"Largest rotation between consecutive keyframes is {max(steps):.0f} deg - overlap may be insufficient."))
    fit = [k.fitness for k in kfs[1:]]; info["mean_fitness"] = round(float(np.mean(fit)), 2)
    if min(fit) < 0.4: msgs.append(("warn", f"Weakest registration overlap fitness is {min(fit):.2f}."))
    px = [k.valid_px for k in kfs]; info["min_valid_px"] = int(min(px))
    if min(px) < 4000: msgs.append(("warn", f"Some keyframes have few valid depth pixels (min {min(px)}); depth may be unreliable (reflective/transparent surface?)."))
    msgs.append(("info", "The surface the bottle rests on hides its base: the bottom cannot be reconstructed unless the bottle is re-posed (not supported)."))
    if not any(m[0] == "warn" for m in msgs): msgs.insert(0, ("info", "No coverage problems detected by automatic checks (this does not guarantee completeness)."))
    return msgs, info


