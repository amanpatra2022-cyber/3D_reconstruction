        self.b_start.setEnabled(cam and st in (ScanState.IDLE, ScanState.DONE))
        self.b_pause.setEnabled(st == ScanState.SCANNING); self.b_resume.setEnabled(st == ScanState.PAUSED and cam)
        self.b_done.setEnabled(st in (ScanState.SCANNING, ScanState.PAUSED) and n > 0)
        self.b_review.setEnabled(n > 0 and st != ScanState.RECONSTRUCTING)
        self.b_cont.setEnabled(st == ScanState.CAPTURED and cam)
        self.b_recon.setEnabled(st in (ScanState.CAPTURED, ScanState.DONE) and n > 0)
        self.b_cancel.setEnabled(st == ScanState.RECONSTRUCTING); self.b_reset.setEnabled(st != ScanState.RECONSTRUCTING)
        self.b_save.setEnabled(self.result is not None and st != ScanState.RECONSTRUCTING)
        self.b_export.setEnabled(self.result is not None); self.b_load.setEnabled(st != ScanState.RECONSTRUCTING)
        stage = {"Idle": "1-2: Detection & live point cloud", "Scanning": "3: Multi-view scanning", "Paused": "3: Scan paused",
                 "Captured (locked)": "3: Captured - review / reconstruct", "Reconstructing": "3: Reconstruction", "Done": "4: Inspection"}
        self.l_stage.setText(stage[st.value])

    # ---- scan actions -----------------------------------------------------------------
    def on_start(self):
        if not (self.last_res and self.last_res.target is not None and self.last_res.valid_px >= self.settings.min_object_px):
            QMessageBox.warning(self, APP_TITLE, "A bottle with enough valid depth must be detected first.\n"
                                "Bring the bottle into the D405 range and click it in the RGB view."); return
        if self.session.keyframes and QMessageBox.question(self, APP_TITLE, "Discard previously captured keyframes and start a new scan?") != QMessageBox.Yes: return
        self.session.reset(); self._warned_ack = False
        with self.session.lock: self.session.state = ScanState.SCANNING; self.session.status = "Waiting for first keyframe"
        self.log("info", "Scan started. Move the camera slowly around the stationary bottle."); self.refresh_ui()
    def on_pause(self):
        with self.session.lock: self.session.state = ScanState.PAUSED
        self.refresh_ui()
    def on_resume(self):
        with self.session.lock: self.session.state = ScanState.SCANNING; self.session.status = "Resumed - return to the last captured view if tracking fails"
        self.refresh_ui()
    def on_continue(self): self.on_resume()
    def on_captured(self):
        with self.session.lock: self.session.state = ScanState.CAPTURED     # worker only appends while SCANNING
        self.refresh_ui(); self.on_review(offer=True)
    def on_review(self, offer=False):
        with self.session.lock: kfs = list(self.session.keyframes); intr = self.session.intr; units = self.session.units
        if not kfs: return
        msgs, info = review_keyframes(kfs, intr, units, self.settings)
        self.proj_info["review"] = dict(info=info, messages=msgs)
        text = "\n".join(f"[{l.upper()}] {m}" for l, m in msgs) + f"\n\nSummary: {json.dumps(info)}"
        for l, m in msgs: self.log(l, m)
        box = QMessageBox(self); box.setWindowTitle("Scan review"); box.setText(text)
        bc = box.addButton("Continue Scanning", QMessageBox.ActionRole) if offer else None
        br = box.addButton("Reconstruct Now", QMessageBox.AcceptRole) if offer and not any(l == "error" for l, _ in msgs) else None
        box.addButton("Close", QMessageBox.RejectRole); box.exec()
        if bc is not None and box.clickedButton() == bc: self.on_continue()
        elif br is not None and box.clickedButton() == br: self._warned_ack = True; self.on_recon()
    def on_reset(self):
        if QMessageBox.question(self, APP_TITLE, "Discard all captured data and the reconstructed model?") != QMessageBox.Yes: return
        self.session.reset(); self.result = None; self.insp.left.clear(); self.insp.right.clear()
        self.tabs.setTabEnabled(1, False); self.l_counts.setText("-"); self.l_track.setText("-"); self.pbar.setValue(0); self.l_prog.setText("Idle")
        self.refresh_ui()

    # ---- reconstruction ---------------------------------------------------------------
    def on_recon(self):
        with self.session.lock:
            if self.session.state not in (ScanState.CAPTURED, ScanState.DONE): return
            kfs = list(self.session.keyframes); intr = self.session.intr; units = self.session.units
        msgs, _ = review_keyframes(kfs, intr, units, self.settings)
        if any(l == "error" for l, _ in msgs): QMessageBox.warning(self, APP_TITLE, "\n".join(m for l, m in msgs if l == "error")); return
        if not self._warned_ack and any(l == "warn" for l, _ in msgs):
            if QMessageBox.question(self, APP_TITLE, "Review found warnings:\n\n" + "\n".join(m for l, m in msgs if l == "warn") +
                                    "\n\nReconstruct anyway? Unobserved surfaces will remain open/missing.") != QMessageBox.Yes: return
        with self.session.lock: self.session.state = ScanState.RECONSTRUCTING
        self.recon = ReconWorker(kfs, intr, units, self.settings)
        self.recon.progress.connect(self._rprog); self.recon.finished_ok.connect(self._rdone)
        self.recon.failed.connect(self._rfail); self.recon.cancelled.connect(self._rcancel); self.recon.start(); self.refresh_ui()
    def _rprog(self, stage, frac): self.l_prog.setText(stage); self.pbar.setValue(int(frac * 1000))
    def _end_recon(self, state):
        with self.session.lock: self.session.state = state
        self.recon = None; self.refresh_ui()
    def _rdone(self, res: ReconResult):
        self.result = res; self.insp.set_result(res); self.tabs.setTabEnabled(1, True); self.tabs.setCurrentIndex(1)
        st = res.stats; self.l_model.setText(f"Mesh {st['vertices']:,} v / {st['triangles']:,} tri | cloud {st['points']:,} pts | "
                                             f"{st['bbox_mm'][0]}x{st['bbox_mm'][1]}x{st['bbox_mm'][2]} mm")
        self.l_prog.setText("Reconstruction finished"); self.pbar.setValue(1000)
        if not st["watertight"]: self.log("warn", "Mesh is not watertight: surfaces that were never observed are NOT filled in.")
        self._end_recon(ScanState.DONE)
    def _rfail(self, tb): self.log("error", "Reconstruction failed:\n" + tb); self.l_prog.setText("Failed"); self.pbar.setValue(0)
    def _after_fail(self): pass
    def _rcancel(self): self.l_prog.setText("Cancelled"); self.pbar.setValue(0); self._end_recon(ScanState.CAPTURED)
    def on_cancel(self):
        if self.recon: self.recon.cancel(); self.l_prog.setText("Cancelling...")

    # ---- project / export -------------------------------------------------------------
    def on_export(self):
        if self.result is None: return
        flt = "Mesh PLY (*.ply);;Mesh OBJ (*.obj);;Mesh STL (*.stl);;Point cloud PLY (*.ply)"
        path, sel = QFileDialog.getSaveFileName(self, "Export model", "bottle", flt)
        if not path: return
        try:
            k = 1000.0 if self.settings.export_units == "mm" else 1.0
            S = np.diag([k, k, k, 1.0])
            if sel.startswith("Point cloud"):
                pc = o3d.geometry.PointCloud(self.result.cloud); pc.transform(S)
                if not path.lower().endswith(".ply"): path += ".ply"
                ok = o3d.io.write_point_cloud(path, pc)
            else:
                m = o3d.geometry.TriangleMesh(self.result.mesh); m.transform(S); m.compute_vertex_normals()
                ext = ".stl" if "STL" in sel else ".obj" if "OBJ" in sel else ".ply"
                if not path.lower().endswith(ext): path += ext
                if ext == ".stl": m.compute_triangle_normals()
                ok = o3d.io.write_triangle_mesh(path, m)
            if not ok: raise RuntimeError("Open3D reported a write failure")
            self.log("info", f"Exported {path} (units: {self.settings.export_units})")
        except Exception as e:
            QMessageBox.critical(self, APP_TITLE, f"Export failed: {e}")
    def on_save(self):
        if self.result is None: return
        d = QFileDialog.getExistingDirectory(self, "Choose / create project folder")
        if not d: return
        try:
            se = self.session
            with se.lock: kfs = list(se.keyframes); intr = se.intr; units = se.units
            meta = dict(format=1, app=APP_TITLE, saved=time.strftime("%Y-%m-%d %H:%M:%S"), units="m",
                        frame="model frame: world(first camera) rotated 180deg about X, bbox centre at origin",
                        model_transform=self.result.model_transform.tolist(), stats=self.result.stats,
                        settings=dataclasses.asdict(self.settings), intrinsics=intr, depth_units=units,
                        review=self.proj_info.get("review"), keyframe_poses=[k.pose.tolist() for k in kfs],
                        keyframe_fitness=[k.fitness for k in kfs])
            with open(os.path.join(d, "project.json"), "w") as fh: json.dump(meta, fh, indent=1, default=str)
            o3d.io.write_triangle_mesh(os.path.join(d, "mesh.ply"), self.result.mesh)
            o3d.io.write_point_cloud(os.path.join(d, "cloud.ply"), self.result.cloud)
            if kfs and QMessageBox.question(self, APP_TITLE, "Also save raw RGB-D keyframes (large) so reconstruction can be re-run with other settings?") == QMessageBox.Yes:
                arr = {}
                for i, k in enumerate(kfs): arr[f"c{i}"] = k.color_rgb; arr[f"d{i}"] = k.depth_obj
                np.savez_compressed(os.path.join(d, "keyframes.npz"), **arr)
            self.log("info", f"Project saved to {d}")
        except Exception as e: QMessageBox.critical(self, APP_TITLE, f"Save failed: {e}")
    def on_load(self):
        d = QFileDialog.getExistingDirectory(self, "Open project folder")
        if not d: return
        try:
            with open(os.path.join(d, "project.json")) as fh: meta = json.load(fh)
            mesh = o3d.io.read_triangle_mesh(os.path.join(d, "mesh.ply")); cloud = o3d.io.read_point_cloud(os.path.join(d, "cloud.ply"))
            if len(mesh.triangles) == 0: raise RuntimeError("mesh.ply is empty")
            mesh.compute_vertex_normals()
            self.session.reset(); self.result = ReconResult(mesh, cloud, meta["stats"], np.array(meta["model_transform"]))
            npz = os.path.join(d, "keyframes.npz")
            if os.path.exists(npz) and meta.get("intrinsics"):
                z = np.load(npz); poses = meta["keyframe_poses"]; fit = meta.get("keyframe_fitness", [1.0] * len(poses))
                with self.session.lock:
                    self.session.keyframes = [Keyframe(z[f"c{i}"], z[f"d{i}"], np.array(poses[i]), fit[i], 0.0, int((z[f"d{i}"] > 0).sum())) for i in range(len(poses))]
                    self.session.intr = meta["intrinsics"]; self.session.units = meta["depth_units"]
            with self.session.lock: self.session.state = ScanState.DONE
            self.insp.set_result(self.result); self.tabs.setTabEnabled(1, True); self.tabs.setCurrentIndex(1)
            self.log("info", "Project loaded. Live tracking state is not restorable; scanning cannot be continued "
                              "(re-reconstruction is possible only if raw keyframes were saved).")
            self.refresh_ui()
        except Exception as e: QMessageBox.critical(self, APP_TITLE, f"Load failed: {e}")

    # ---- shutdown ---------------------------------------------------------------------
    def closeEvent(self, ev):
        self.timer.stop()
        if self.recon: self.recon.cancel(); self.recon.wait(10000)
        self.perc.stop(); self.perc.wait(10000)
        self.cam.stop(); self.cam.wait(10000)
        ev.accept()


def main():
    print("Initializing Qt SurfaceFormat...", flush=True)
    fmt = QSurfaceFormat(); fmt.setDepthBufferSize(24); fmt.setSamples(4); fmt.setVersion(2, 1)
